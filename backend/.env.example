# Database: schema PostgreSQL tên "pet-shop" (xem ../schema.sql)
DATABASE_URL="postgresql://postgres:password@localhost:5432/petshop?schema=pet-shop"

PORT=8000
NODE_ENV=development

# CORS: danh sách origin được phép, phân tách bằng dấu phẩy
FRONTEND_URL=http://localhost:3002

# JWT — BẮT BUỘC đặt giá trị riêng, ngẫu nhiên khi NODE_ENV=production (ví dụ: openssl rand -hex 32)
JWT_SECRET=
# Thời hạn đăng nhập (7d, 12h...). Mặc định 7d
JWT_EXPIRES_IN=7d

# Tài khoản mặc định — tự tạo khi backend khởi động (và khi npm run seed) nếu chưa tồn tại.
# Không ghi đè mật khẩu của tài khoản đã có. Để trống = bỏ qua tài khoản đó.
# NODE_ENV=production mà chưa có admin và ADMIN_PASSWORD trống => backend từ chối khởi động.
# Email đăng nhập của 3 tài khoản mặc định (bỏ trống = admin@/monitor@/guest@petshop.vn)
ADMIN_EMAIL=
MONITOR_EMAIL=
GUEST_EMAIL=
ADMIN_PASSWORD=      # admin@petshop.vn (super admin)
MONITOR_PASSWORD=    # monitor@petshop.vn (nhân viên)
GUEST_PASSWORD=      # guest@petshop.vn (khách hàng mẫu)

# Email gửi link "quên mật khẩu" (SMTP). Link trỏ về FRONTEND_URL (origin đầu tiên).
# Không đặt SMTP_HOST: dev chỉ in link ra log backend; production KHÔNG gửi được email.
# Ví dụ Gmail: smtp.gmail.com / 587 / tài khoản + "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PetShop <no-reply@domain.com>

# Đặt 1 khi chạy sau reverse proxy (nginx, Cloudflare...) để rate-limit lấy đúng IP khách. Bỏ trống nếu truy cập trực tiếp.
TRUST_PROXY=
