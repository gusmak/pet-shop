# Copy file này thành `.env` rồi sửa giá trị trước khi chạy production.
# Bắt buộc có `.env` với POSTGRES_PASSWORD, JWT_SECRET, ADMIN_PASSWORD (các biến còn lại có mặc định cho local).

POSTGRES_DB=petshop
POSTGRES_USER=petshop
POSTGRES_PASSWORD=thay-bang-mat-khau-manh

# Bắt buộc đổi khi lên production (vd: openssl rand -hex 32)
JWT_SECRET=thay-bang-chuoi-ngau-nhien
# Thời hạn đăng nhập (7d, 12h...). Mặc định 7d
JWT_EXPIRES_IN=7d

# Mật khẩu tài khoản mặc định, tự tạo ở lần khởi chạy đầu (không ghi đè nếu tài khoản đã tồn tại)
# admin@petshop.vn — BẮT BUỘC; monitor@petshop.vn / guest@petshop.vn — để trống nếu không cần
# Email đăng nhập của 3 tài khoản mặc định (bỏ trống = admin@/monitor@/guest@petshop.vn)
ADMIN_EMAIL=
MONITOR_EMAIL=
GUEST_EMAIL=
ADMIN_PASSWORD=
MONITOR_PASSWORD=
GUEST_PASSWORD=

# Email gửi link "quên mật khẩu" (SMTP). Link trỏ về FRONTEND_URL (origin đầu tiên).
# Không đặt SMTP_HOST: dev chỉ in link ra log backend; production KHÔNG gửi được email.
# Ví dụ Gmail: smtp.gmail.com / 587 / tài khoản + "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PetShop <no-reply@domain.com>

# Đặt 1 khi chạy sau reverse proxy (nginx, Cloudflare...) để rate-limit lấy đúng IP khách. Bỏ trống nếu truy cập trực tiếp.
TRUST_PROXY=

# Origin mà trình duyệt mở frontend (CORS backend)
FRONTEND_URL=http://localhost:3006

# API backend mà trình duyệt gọi (build-time của frontend)
NEXT_PUBLIC_API_URL=http://localhost:8060