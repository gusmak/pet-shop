# Copy file này thành `.env` rồi sửa giá trị trước khi chạy production.
# Không cần tạo `.env` nếu chỉ chạy thử local (docker-compose đã có giá trị mặc định).

POSTGRES_DB=petshop
POSTGRES_USER=petshop
POSTGRES_PASSWORD=thay-bang-mat-khau-manh

# Bắt buộc đổi khi lên production (vd: openssl rand -hex 32)
JWT_SECRET=thay-bang-chuoi-ngau-nhien

# Origin mà trình duyệt mở frontend (CORS backend)
FRONTEND_URL=http://localhost:3006

# API backend mà trình duyệt gọi (build-time của frontend)
NEXT_PUBLIC_API_URL=http://localhost:8060